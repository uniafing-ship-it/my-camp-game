{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "deploy/godot-stage10-web": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_PROJECT_ID\" = \"prj_MOy0bFQpENg7reA6VmEDZ61Fx5Uj\" ]; then echo 'Skipping legacy duplicate Vercel project my-camp-game-zjx4'; exit 0; else exit 1; fi"
}
